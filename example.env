KEY=your_key
SECRET=your_secret
PAIR=DOTEUR

# ==================== MODE SELECTION ====================
# MODE: SIMPLE (default) or SMART
# SIMPLE: Executes purchase immediately based on TYPE and price calculations
# SMART: Monitors price and purchases when threshold is met or at period end
MODE=SIMPLE

# ==================== SIMPLE MODE CONFIGURATION ====================
# These settings apply when MODE=SIMPLE

TYPE=CLOSE_AVERAGE
QUANTITY_FIRST=
QUANTITY_SECOND=15
DAYS=15
LESS_PERCENTAGE=0.01

# ==================== SMART MODE CONFIGURATION ====================
# These settings apply when MODE=SMART

# SMART_PERIOD: How often to make purchases
# Options: WEEKLY, BIWEEKLY, MONTHLY, 2_TIMES_MONTH, 3_TIMES_MONTH, 4_TIMES_MONTH
SMART_PERIOD=4_TIMES_MONTH

# ===== MULTIPLE THRESHOLDS (Advanced DCA) =====
# SMART_THRESHOLDS: Define multiple price drop thresholds with budget allocation
# Format: "drop1:budget1,drop2:budget2,drop3:budget3,drop4:budget4"
# Each threshold triggers a purchase of X% of your total budget
# Example: "1:25,3:25,5:25,10:25" means:
#   - When price drops 1%, buy 25% of budget
#   - When price drops 3%, buy another 25%
#   - When price drops 5%, buy another 25%
#   - When price drops 10%, buy last 25%
# Leave empty to use legacy single threshold mode
SMART_THRESHOLDS=1:25,3:25,5:25,10:25

# SMART_THRESHOLD_PERCENT: Single threshold (legacy mode, ignored if SMART_THRESHOLDS is set)
# Example: 3 means buy when price drops 3% or more from period start
SMART_THRESHOLD_PERCENT=3

# SMART_FALLBACK_HOUR: Hour of day (0-23) to force purchase on last day of period
# if no thresholds were met. Ensures you don't miss a period's purchase.
SMART_FALLBACK_HOUR=22

# SMART_STATE_FILE: Path to JSON file storing purchase history
SMART_STATE_FILE=./state.json

# ===== BINANCE PRICE COMPARISON =====
# BINANCE_COMPARE: Compare Kraken price with Binance before purchasing
# If enabled, will skip purchase if Kraken is significantly more expensive
BINANCE_COMPARE=true

# BINANCE_MAX_DIFF_PERCENT: Maximum acceptable price difference (%)
# If Kraken price is higher than Binance by this %, skip purchase
# Recommended: 0.3-0.5% (conservative), 1.0% (aggressive)
BINANCE_MAX_DIFF_PERCENT=0.5

# ===== TELEGRAM NOTIFICATIONS =====
# TELEGRAM_ENABLED: Enable Telegram notifications
TELEGRAM_ENABLED=false

# TELEGRAM_BOT_TOKEN: Your Telegram bot token (get from @BotFather)
# Example: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=

# TELEGRAM_CHAT_ID: Your Telegram chat ID (get from @userinfobot)
# Example: 123456789
TELEGRAM_CHAT_ID=

# ==================== COMMON SETTINGS ====================
SIMULATOR=false